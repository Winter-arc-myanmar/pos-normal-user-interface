# ---------------------------------------------------------------------------
# Vision POS - Docker production settings.
# Copy to ".env" next to docker-compose.yml and adjust for the target server.
# ---------------------------------------------------------------------------

# Host port the SPA is published on (container always listens on 80).
APP_PORT=8080

# Reuse this local image when starting/restarting; build explicitly for updates.
APP_IMAGE=vision-pos-web:latest

# Nginx runtime ceilings (not Node build limits); tune after measuring traffic.
WEB_CPUS=0.50
WEB_MEMORY_LIMIT=128m
WEB_MEMORY_RESERVATION=32m

# Origin of the JS bundle's API calls (Vite inlines this at BUILD time).
#   * Default: call the API origin directly (cross-origin, like today).
#   * To route through the same-origin nginx proxy instead, set this to the
#     site's own origin (e.g. https://vision.example.com) so CORS is avoided.
VITE_API_URL=https://apivision.winterarc.asia

# Backend origin used by the optional same-origin proxy for /api, /csrf and
# /uploads. Change this at RUNTIME - no image rebuild required.
API_UPSTREAM=https://apivision.winterarc.asia
